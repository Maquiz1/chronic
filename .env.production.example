# Server settings for the DCLD study system (Docker). On the server: cp .env.production.example .env, then fill in.
# Never commit the real .env. Generate secrets with:  openssl rand -base64 48

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=chronic.tamris.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://chronic.tamris.org
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam
SITE_URL=https://chronic.tamris.org
SITE_NAME=DCLD Study
# Keep true. Set false only for a first test over plain HTTP (logins need HTTPS: cookies are secure).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=3600

# --- MySQL (the cld-db container) ---
DB_NAME=cld_study
DB_USER=cld_study
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Docker ---
# Port on 127.0.0.1 that the host nginx forwards to (8090 = penplus, 8091 = dimension).
WEB_PORT=8092

# --- Study ---
STUDY_ID_PREFIX=CLD
# YYYY-MM-DD; interviews before this date are flagged by the data quality checks.
STUDY_START_DATE=

# --- Email: registration links, password reset, approvals. These MUST work for people to register. ---
# Hostinger mail (same as tamris):
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=info@tamris.org
EMAIL_HOST_PASSWORD=change-me
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL="DCLD Study <info@tamris.org>"
