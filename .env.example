# Local development with Docker: cp .env.example .env && docker compose up --build
# Then: docker compose exec cld-web python manage.py migrate && docker compose exec cld-web python manage.py createsuperuser
# Open http://127.0.0.1:8093

DJANGO_SECRET_KEY=local-dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8093
SITE_NAME=DCLD Study

DB_NAME=cld_study
DB_USER=cld_study
DB_PASSWORD=local-dev-password
DB_ROOT_PASSWORD=local-root-password
WEB_PORT=8093

# Emails are written to files in the sent_emails volume (see: docker compose exec cld-web ls sent_emails)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=sent_emails

STUDY_ID_PREFIX=CLD
STUDY_START_DATE=

EXPORT_FILE_HOURS=24
PENDING_REMINDER_DAYS=2
